{
  "openapi": "3.0.3",
  "info": {
    "title": "BarberPro AI CRM API",
    "version": "1.2.0",
    "description": "Multi-shop barber CRM API with customer authentication, staff scheduling, services and appointment booking."
  },
  "servers": [
    {
      "url": "/",
      "description": "Current server"
    }
  ],
  "tags": [
    {
      "name": "Authentication",
      "description": "Account registration, login, token rotation, and profile"
    },
    {
      "name": "Customers",
      "description": "Customer registration"
    },
    {
      "name": "Booking",
      "description": "Shop discovery, services, staff availability and appointments"
    }
  ],
  "paths": {
    "/api/auth/register": {
      "post": {
        "tags": [
          "Authentication"
        ],
        "summary": "Register a customer account",
        "operationId": "registerAccount",
        "description": "Creates a CUSTOMER account. Public registration cannot assign privileged roles. Passwords are hashed with Argon2id.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Account created and token pair issued.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthResponse"
                }
              }
            }
          },
          "400": {
            "description": "Validation failed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Email is already registered.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Registration rate limit exceeded."
          },
          "500": {
            "description": "Unexpected server error."
          }
        }
      }
    },
    "/api/auth/login": {
      "post": {
        "tags": [
          "Authentication"
        ],
        "summary": "Log in",
        "operationId": "login",
        "description": "Verifies credentials and issues an access JWT and refresh JWT.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Authenticated.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthResponse"
                }
              }
            }
          },
          "401": {
            "description": "Invalid email or password.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Login rate limit exceeded."
          },
          "500": {
            "description": "Unexpected server error."
          }
        }
      }
    },
    "/api/auth/refresh": {
      "post": {
        "tags": [
          "Authentication"
        ],
        "summary": "Rotate refresh token",
        "operationId": "refreshTokens",
        "description": "Consumes a valid refresh JWT once and returns a new token pair. Reuse of a revoked refresh token revokes its token family.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RefreshRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Token pair rotated.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthResponse"
                }
              }
            }
          },
          "400": {
            "description": "Refresh token is required.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Refresh token invalid, expired, or reused.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Token request rate limit exceeded."
          }
        }
      }
    },
    "/api/auth/logout": {
      "post": {
        "tags": [
          "Authentication"
        ],
        "summary": "Log out",
        "operationId": "logout",
        "description": "Revokes all refresh tokens in the supplied token family. This endpoint is idempotent.",
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RefreshRequest"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Session revoked or already invalid."
          },
          "429": {
            "description": "Token request rate limit exceeded."
          }
        }
      }
    },
    "/api/auth/me": {
      "get": {
        "tags": [
          "Authentication"
        ],
        "summary": "Get current user",
        "operationId": "getCurrentUser",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Current active user.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "user"
                  ],
                  "properties": {
                    "user": {
                      "$ref": "#/components/schemas/User"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid, or expired access token.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected server error."
          }
        }
      }
    },
    "/api/customers": {
      "post": {
        "tags": [
          "Customers"
        ],
        "summary": "Register a customer",
        "operationId": "registerCustomer",
        "description": "Creates a customer record independently of login accounts. Email addresses are trimmed, lowercased, and must be unique. Limited to 10 requests per client IP in a 15-minute window.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CustomerRegistration"
              },
              "example": {
                "name": "Alex Morgan",
                "email": "alex@example.com",
                "phone": "+1 555 010 1234"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Customer registered successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "customer"
                  ],
                  "properties": {
                    "customer": {
                      "$ref": "#/components/schemas/Customer"
                    }
                  }
                },
                "example": {
                  "customer": {
                    "id": "1",
                    "name": "Alex Morgan",
                    "email": "alex@example.com",
                    "phone": "+1 555 010 1234",
                    "created_at": "2026-11-14T13:58:56.000Z"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid fields or malformed JSON.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "A customer with this email already exists.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "413": {
            "description": "Request body exceeds the 10 KB limit.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Registration rate limit exceeded (10 requests per 15 minutes)."
          },
          "500": {
            "description": "Unexpected server error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/shops": {
      "get": {
        "tags": [
          "Booking"
        ],
        "summary": "List active shops",
        "responses": {
          "200": {
            "description": "Active shops"
          }
        }
      },
      "post": {
        "tags": [
          "Booking"
        ],
        "summary": "Create a shop",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "responses": {
          "201": {
            "description": "Shop created"
          },
          "400": {
            "description": "Invalid shop data"
          },
          "403": {
            "description": "ADMIN role required"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "name",
                  "slug"
                ],
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "slug": {
                    "type": "string"
                  },
                  "address": {
                    "type": "string"
                  },
                  "phone": {
                    "type": "string"
                  },
                  "timezone": {
                    "type": "string",
                    "example": "Asia/Kolkata"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/shops/{shopId}/services": {
      "get": {
        "tags": [
          "Booking"
        ],
        "summary": "List active shop services",
        "responses": {
          "200": {
            "description": "Services"
          }
        }
      },
      "post": {
        "tags": [
          "Booking"
        ],
        "summary": "Create a shop service",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "responses": {
          "201": {
            "description": "Service created"
          },
          "400": {
            "description": "Invalid service"
          },
          "403": {
            "description": "ADMIN role required"
          }
        },
        "parameters": [
          {
            "in": "path",
            "name": "shopId",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "name",
                  "durationMinutes",
                  "price"
                ],
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "description": {
                    "type": "string"
                  },
                  "durationMinutes": {
                    "type": "integer",
                    "minimum": 5,
                    "maximum": 240
                  },
                  "price": {
                    "type": "number",
                    "minimum": 0
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/shops/{shopId}/availability": {
      "get": {
        "tags": [
          "Booking"
        ],
        "summary": "Find available appointment start times",
        "responses": {
          "200": {
            "description": "Available 15-minute slots in the shop's timezone"
          },
          "400": {
            "description": "Invalid query"
          }
        },
        "parameters": [
          {
            "in": "path",
            "name": "shopId",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "serviceId",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "date",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "in": "query",
            "name": "staffId",
            "required": false,
            "schema": {
              "type": "integer"
            }
          }
        ]
      }
    },
    "/api/shops/{shopId}/staff": {
      "post": {
        "tags": [
          "Booking"
        ],
        "summary": "Add a barber to a shop",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "responses": {
          "201": {
            "description": "Staff member added"
          },
          "404": {
            "description": "Shop or active BARBER not found"
          }
        },
        "parameters": [
          {
            "in": "path",
            "name": "shopId",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "userId",
                  "displayName"
                ],
                "properties": {
                  "userId": {
                    "type": "integer"
                  },
                  "displayName": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/staff/{staffId}/hours": {
      "put": {
        "tags": [
          "Booking"
        ],
        "summary": "Set weekly barber working hours",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Hours saved"
          },
          "400": {
            "description": "Invalid schedule"
          }
        },
        "parameters": [
          {
            "in": "path",
            "name": "staffId",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "dayOfWeek",
                  "opensAt",
                  "closesAt"
                ],
                "properties": {
                  "dayOfWeek": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 6
                  },
                  "opensAt": {
                    "type": "string",
                    "example": "09:00"
                  },
                  "closesAt": {
                    "type": "string",
                    "example": "18:00"
                  },
                  "isActive": {
                    "type": "boolean"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/staff/{staffId}/time-off": {
      "post": {
        "tags": [
          "Booking"
        ],
        "summary": "Add barber time off",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "responses": {
          "201": {
            "description": "Time off saved"
          }
        },
        "parameters": [
          {
            "in": "path",
            "name": "staffId",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "startsAt",
                  "endsAt"
                ],
                "properties": {
                  "startsAt": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "endsAt": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "reason": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/staff/{staffId}/services/{serviceId}": {
      "post": {
        "tags": [
          "Booking"
        ],
        "summary": "Assign a service to a barber",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "responses": {
          "201": {
            "description": "Assignment saved"
          },
          "404": {
            "description": "Staff and service must belong to same shop"
          }
        },
        "parameters": [
          {
            "in": "path",
            "name": "staffId",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "in": "path",
            "name": "serviceId",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ]
      }
    },
    "/api/appointments": {
      "post": {
        "tags": [
          "Booking"
        ],
        "summary": "Book an appointment",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "responses": {
          "201": {
            "description": "Appointment booked"
          },
          "400": {
            "description": "Invalid booking"
          },
          "403": {
            "description": "Customer account required"
          },
          "409": {
            "description": "Slot unavailable or concurrently booked"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "shopId",
                  "serviceId",
                  "staffId",
                  "startsAt"
                ],
                "properties": {
                  "shopId": {
                    "type": "integer"
                  },
                  "serviceId": {
                    "type": "integer"
                  },
                  "staffId": {
                    "type": "integer"
                  },
                  "startsAt": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "customerNotes": {
                    "type": "string",
                    "maxLength": 1000
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/appointments/mine": {
      "get": {
        "tags": [
          "Booking"
        ],
        "summary": "List my appointments",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Customer appointment history"
          }
        }
      }
    },
    "/api/appointments/{appointmentId}/cancel": {
      "patch": {
        "tags": [
          "Booking"
        ],
        "summary": "Cancel an upcoming appointment",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Appointment cancelled"
          },
          "404": {
            "description": "Appointment not found or not cancellable"
          }
        },
        "parameters": [
          {
            "in": "path",
            "name": "appointmentId",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ]
      }
    },
    "/api/admin/dashboard": {
      "get": {
        "tags": [
          "Admin"
        ],
        "summary": "Cross-shop dashboard metrics",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "in": "query",
            "name": "from",
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "in": "query",
            "name": "to",
            "schema": {
              "type": "string",
              "format": "date"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Shop totals, appointment outcomes and completed-service revenue"
          },
          "403": {
            "description": "ADMIN role required"
          }
        }
      }
    },
    "/api/admin/shops": {
      "get": {
        "tags": [
          "Admin"
        ],
        "summary": "List all shops and catalogue counts",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Shop list"
          }
        }
      }
    },
    "/api/admin/shops/{shopId}": {
      "patch": {
        "tags": [
          "Admin"
        ],
        "summary": "Update shop profile or active state",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "in": "path",
            "name": "shopId",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "address": {
                    "type": "string"
                  },
                  "phone": {
                    "type": "string"
                  },
                  "timezone": {
                    "type": "string"
                  },
                  "isActive": {
                    "type": "boolean"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated shop"
          },
          "400": {
            "description": "Invalid update"
          },
          "404": {
            "description": "Shop not found"
          }
        }
      }
    },
    "/api/admin/staff-performance": {
      "get": {
        "tags": [
          "Admin"
        ],
        "summary": "Staff performance by shop",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "in": "query",
            "name": "from",
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "in": "query",
            "name": "to",
            "schema": {
              "type": "string",
              "format": "date"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Appointment outcomes and completed-service revenue by barber"
          }
        }
      }
    },
    "/api/admin/reports": {
      "get": {
        "tags": [
          "Admin"
        ],
        "summary": "Shop appointment and revenue report",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "in": "query",
            "name": "from",
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "in": "query",
            "name": "to",
            "schema": {
              "type": "string",
              "format": "date"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Shop-level report"
          }
        }
      }
    },
    "/api/admin/services": {
      "get": {
        "tags": [
          "Admin"
        ],
        "summary": "List services across all shops",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Service catalogue"
          }
        }
      }
    },
    "/api/admin/services/{serviceId}": {
      "patch": {
        "tags": [
          "Admin"
        ],
        "summary": "Update service details or active state",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "in": "path",
            "name": "serviceId",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "description": {
                    "type": "string"
                  },
                  "durationMinutes": {
                    "type": "integer",
                    "minimum": 5,
                    "maximum": 240
                  },
                  "price": {
                    "type": "number",
                    "minimum": 0
                  },
                  "isActive": {
                    "type": "boolean"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated service"
          },
          "400": {
            "description": "Invalid update"
          },
          "404": {
            "description": "Service not found"
          }
        }
      }
    },
    "/api/barber/dashboard": {
      "get": {
        "tags": [
          "Barber"
        ],
        "summary": "Barber dashboard and upcoming appointments",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Own shop metrics and assigned upcoming appointments"
