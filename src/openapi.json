  },
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Use the access token returned by /api/auth/register or /api/auth/login."
      }
    },
    "schemas": {
      "RegisterRequest": {
        "type": "object",
        "required": [
          "name",
          "email",
          "password"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120,
            "example": "Alex Morgan"
          },
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 254,
            "example": "alex@example.com"
          },
          "password": {
            "type": "string",
            "format": "password",
            "minLength": 12,
            "maxLength": 128,
            "example": "a-long-unique-password"
          }
        }
      },
      "LoginRequest": {
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "additionalProperties": false,
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 254
          },
          "password": {
            "type": "string",
            "format": "password",
            "maxLength": 128
          }
        }
      },
      "RefreshRequest": {
        "type": "object",
        "required": [
          "refreshToken"
        ],
        "additionalProperties": false,
        "properties": {
          "refreshToken": {
            "type": "string",
            "description": "The latest refresh JWT. It is single-use and is replaced on successful rotation."
          }
        }
      },
      "AuthResponse": {
        "type": "object",
        "required": [
          "user",
          "tokens"
        ],
        "properties": {
          "user": {
            "$ref": "#/components/schemas/User"
          },
          "tokens": {
            "$ref": "#/components/schemas/TokenPair"
          }
        }
      },
      "TokenPair": {
        "type": "object",
        "required": [
          "accessToken",
          "refreshToken",
          "tokenType",
          "expiresIn",
          "refreshExpiresAt"
        ],
        "properties": {
          "accessToken": {
            "type": "string",
            "description": "Signed access JWT; valid for 15 minutes."
          },
          "refreshToken": {
            "type": "string",
            "description": "Signed refresh JWT; valid for 7 days and rotated on use."
          },
          "tokenType": {
            "type": "string",
            "enum": [
              "Bearer"
            ]
          },
          "expiresIn": {
            "type": "integer",
            "example": 900
          },
          "refreshExpiresAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "User": {
        "type": "object",
        "required": [
          "id",
          "name",
          "email",
          "role"
        ],
        "properties": {
          "id": {
            "type": "string",
            "example": "1"
          },
          "name": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "role": {
            "type": "string",
            "enum": [
              "ADMIN",
              "BARBER",
              "CUSTOMER"
            ]
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "CustomerRegistration": {
        "type": "object",
        "required": [
          "name",
          "email"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120,
            "description": "Customer's name; whitespace is trimmed.",
            "example": "Alex Morgan"
          },
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 254,
            "description": "Unique email address; whitespace is trimmed and stored lowercase.",
            "example": "alex@example.com"
          },
          "phone": {
            "type": "string",
            "minLength": 7,
            "maxLength": 30,
            "pattern": "^[+\\\\d().\\\\-\\\\s]{7,30}$",
            "description": "Optional phone number containing digits or common phone-number characters.",
            "example": "+1 555 010 1234"
          }
        }
      },
      "Customer": {
        "type": "object",
        "required": [
          "id",
          "name",
          "email",
          "phone",
          "created_at"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "Database-generated customer ID."
          },
          "name": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "phone": {
            "type": "string",
            "nullable": true
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Error": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "string"
          },
          "details": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
