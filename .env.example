PORT=3000
PORT_BIND_ADDRESS=127.0.0.1
POSTGRES_DB=barberpro
POSTGRES_USER=barberpro
POSTGRES_PASSWORD_FILE=./secrets/db_password.txt
JWT_ACCESS_SECRET_FILE=./secrets/jwt_access_secret.txt
JWT_REFRESH_SECRET_FILE=./secrets/jwt_refresh_secret.txt
JWT_ISSUER=barberpro-ai-crm
JWT_AUDIENCE=barberpro-api

# Razorpay test/live credentials (leave unset to disable checkout)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Optional trusted operator bootstrap key (minimum 32 random bytes).
# Required only for the one-time initial ADMIN/BARBER/shop provisioning endpoint.
OPERATOR_PROVISIONING_SECRET=

# Optional custom-domain routing (leave blank until both domains are attached to Render).
# Add both hostnames to the SAME existing web service; do not create a second CRM database.
MARKETING_HOSTNAME=www.barberpro.in
APP_HOSTNAME=app.barberpro.in
MARKETING_BASE_URL=https://www.barberpro.in
APP_BASE_URL=https://app.barberpro.in
